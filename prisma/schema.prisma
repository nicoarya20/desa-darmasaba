// ========================================= POSYANDU ========================================= //
model Posyandu {
  id              String                 @id @default(cuid())
  name            String
  nomor           String
  deskripsi       String
  jadwalPelayanan String
  image           FileStorage?           @relation(fields: [imageId], references: [id])
  imageId         String?
  banjar          Banjar?                @relation(fields: [banjarId], references: [id])
  banjarId        String?
  // Alamat tempat posyandu di banjar; nullable karena data lama belum punya alamat.
  alamat          String?                @db.Text
  ibuHamil        IbuHamil[]
  balita          Balita[]
  fotoKegiatan    FotoKegiatanPosyandu[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime               @default(now())
  isActive        Boolean                @default(true)
}

// Deskripsi umum halaman Posyandu (singleton, pola ProfilBumDes): satu baris ber-id tetap, ditulis lewat upsert.
model ProfilPosyandu {
  id             String   @id @default("profil-posyandu")
  deskripsi      String   @db.Text
  fungsiKegiatan String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Kegiatan posyandu per klaster sasaran. `sasaran` dibatasi balita | remaja | lansia (validasi API + CHECK di
// migrasi) dan unik: tiap klaster tepat satu baris, dibuat default oleh migrasi 20261116160000_konten_posyandu.
model KlasterPosyandu {
  id           String       @id @default(cuid())
  sasaran      String       @unique
  judul        String
  deskripsi    String       @db.Text
  jamPelayanan String?
  image        FileStorage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId      String?
  urutan       Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Galeri foto lokasi & kader posyandu banjar (fondasi konten bersama); hapus permanen, tanpa panel Sampah.
model FotoKegiatanPosyandu {
  id         String      @id @default(cuid())
  posyandu   Posyandu    @relation(fields: [posyanduId], references: [id], onDelete: Cascade)
  posyanduId String
  image      FileStorage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId    String
  keterangan String?
  urutan     Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([posyanduId, urutan])
}

// ========================================= PUSKESMAS ========================================= //
model Puskesmas {
  id        String          @id @default(cuid())
  name      String
  alamat    String
  jam       JamOperasional  @relation(fields: [jamId], references: [id])
  jamId     String
  image     FileStorage?    @relation(fields: [imageId], references: [id])
  imageId   String?
  kontak    KontakPuskesmas @relation(fields: [kontakId], references: [id])
  kontakId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime        @default(now())
  isActive  Boolean         @default(true)

  // Konten PUSTU (Puskesmas Pembantu) di halaman publik. Semua opsional agar baris lama tetap valid.
  // Daftar { platform, url }; divalidasi skema bersama src/lib/konten-bersama/media-sosial.validation.ts.
  mediaSosial         Json?
  // Daftar { judul, deskripsi }; divalidasi src/lib/pustu/pustu.validation.ts (dibaca utuh bersama barisnya).
  layananUnggulan     Json?
  linkPetunjukArah    String?
  // Teks kaya editor admin, disanitasi saat simpan (src/lib/rich-text-server.ts).
  prosedurPendaftaran String?             @db.Text
  tarifBpjs           String?             @db.Text
  tarifUmum           String?             @db.Text
  fotoBaganStruktur   FileStorage?        @relation("PustuFotoBagan", fields: [fotoBaganStrukturId], references: [id], onDelete: SetNull)
  fotoBaganStrukturId String?
  pengurus            PengurusPustu[]
  fotoKegiatan        FotoKegiatanPustu[]
}

// Pengurus PUSTU (struktur organisasi sederhana: nama + jabatan, tanpa NIP); hapus = hapus baris + foto.
model PengurusPustu {
  id        String       @id @default(cuid())
  pustu     Puskesmas    @relation(fields: [pustuId], references: [id], onDelete: Cascade)
  pustuId   String
  nama      String
  jabatan   String
  image     FileStorage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId   String?
  urutan    Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([pustuId, urutan])
}

// Galeri foto PUSTU (lokasi, fasilitas, kegiatan); hapus permanen (tanpa panel Sampah).
model FotoKegiatanPustu {
  id         String      @id @default(cuid())
  pustu      Puskesmas   @relation(fields: [pustuId], references: [id], onDelete: Cascade)
  pustuId    String
  image      FileStorage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId    String
  keterangan String?
  urutan     Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([pustuId, urutan])
}

model JamOperasional {
  id        String      @id @default(cuid())
  // Kolom lama (jam buka, jam tutup, teks akhir pekan/libur) tidak ditulis lagi; dipertahankan agar data lama
  // tidak hilang. Pengganti: `jadwal` daftar { hari, jam } (format desa: "Senin – Kamis" / "08.00 – 14.00 WITA").
  workDays  String?
  weekDays  String?
  holiday   String?
  jadwal    Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime    @default(now())
  isActive  Boolean     @default(true)
  Puskesmas Puskesmas[]
}

model KontakPuskesmas {
  id              String      @id @default(cuid())
  // Semua opsional: tidak semua PUSTU punya email/telepon. `kontakUGD` = "Kontak Darurat / Ambulans".
  kontakPuskesmas String?
  email           String?
  // Lama: tidak ditulis lagi, nilainya dipindah ke `Puskesmas.mediaSosial` (migrasi 20261116150000_konten_pustu).
  facebook        String?
  kontakUGD       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime    @default(now())
  isActive        Boolean     @default(true)
  Puskesmas       Puskesmas[]
}

