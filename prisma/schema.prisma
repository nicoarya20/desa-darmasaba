  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime            @default(now())
  isActive             Boolean             @default(true)
  CategoryPengumuman   CategoryPengumuman? @relation(fields: [categoryPengumumanId], references: [id])
  categoryPengumumanId String?
  // Lampiran (ikut pola Berita): pengumuman resmi desa umumnya berupa scan dokumen + PDF,
  // bukan teks. Semua opsional — pengumuman lama tanpa lampiran tetap valid.
  image                FileStorage?        @relation("PengumumanImage", fields: [imageId], references: [id])
  imageId              String? // gambar/poster utama (thumbnail kartu)
  images               FileStorage[]       @relation("PengumumanImages") // galeri gambar tambahan
  dokumen              FileStorage[]       @relation("PengumumanDokumen") // lampiran dokumen (PDF)
  // Tanggal asli pengumuman (bisa beda dari createdAt untuk data impor). Baris lama di-backfill = createdAt.
  tanggalTerbit        DateTime            @default(now())

  @@index([categoryPengumumanId])
}

