// Letak & batas wilayah desa. Singleton: hanya satu baris (id tetap
// "wilayah-desa", di-upsert dari admin). Semua kolom nullable agar tabel boleh
// kosong sebelum admin mengisi; aturan wajib-isi ditegakkan di API.
model WilayahDesa {
  id           String    @id @default(cuid())
  batasUtara   String?
  batasSelatan String?
  batasTimur   String?
  batasBarat   String?
  // Satuan: hektar (ha).
  luasWilayah  Float?
  keterangan   String?   @db.Text
  // URL embed peta (hanya https), dirender sebagai iframe di halaman publik.
  petaEmbedUrl String?
  // File peta (gambar/PDF) di FileStorage, ditampilkan di atas peta embed. Opsional.
  petaFileId   String?
  petaFile     FileStorage? @relation("WilayahDesaPetaFile", fields: [petaFileId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isActive     Boolean   @default(true)
}

// Kontak resmi kantor desa (footer publik & halaman PPID), diedit admin di Profil Desa > Kontak Desa. Singleton: satu
// baris dengan id tetap "kontak-desa" (src/lib/kontak-desa.ts), di-upsert dari admin. Tanpa isActive/deletedAt karena
// barisnya tidak pernah dihapus, hanya diperbarui. Baris awal diisi migrasi dari konstanta lama (bukan seeder).
model KontakDesa {
  id         String   @id
  namaKantor String
  alamat     String
  telepon    String
  email      String
  // Opsional: desa belum memberi nomor WhatsApp. null = tidak ditampilkan di footer/PPID; bila diisi harus nomor seluler.
  whatsapp   String?
  // Opsional: jam layanan kantor sebagai teks bebas (mis. "Senin–Jumat 07.30–15.30"). null = tidak ditampilkan di footer/PPID.
  jamLayanan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

