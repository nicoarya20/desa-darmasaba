  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

model KeteranganBankSampahTerdekat {
  id               String   @id @default(cuid())
  name             String
  alamat           String
  namaTempatMaps   String
  linkPetunjukArah String
  lat              Float
  lng              Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime @default(now())
  isActive         Boolean  @default(true)

  // Detail di modal publik (Profil/Struktur/Dokumentasi). Semua opsional agar baris lama tetap valid.
  deskripsi           String?                  @db.Text
  kontak              String?
  // Daftar { platform, url }; divalidasi skema bersama src/lib/konten-bersama/media-sosial.validation.ts.
  mediaSosial         Json?
  fotoBaganStruktur   FileStorage?             @relation("BankSampahFotoBagan", fields: [fotoBaganStrukturId], references: [id], onDelete: SetNull)
  fotoBaganStrukturId String?
  pengurus            PengurusBankSampah[]
  fotoKegiatan        FotoKegiatanBankSampah[]
  programInovasi      ProgramInovasi[]         @relation("BankSampahProgramInovasi")
}

// Pengurus bank sampah (struktur organisasi sederhana: nama + jabatan); hapus = hapus baris + foto.
model PengurusBankSampah {
