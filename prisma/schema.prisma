  name               String
  email              String
  nomorTelepon       String
  nik                String
  judulPengaduan     String
  lokasiKejadian     String
  image              FileStorage?   @relation(fields: [imageId], references: [id])
  imageId            String?
  deskripsiPengaduan String         @db.Text
  jenisPengaduan     JenisPengaduan @relation(fields: [jenisPengaduanId], references: [id])
  jenisPengaduanId   String
  // Tindak lanjut pengaduan (Juknis lomba 3.3). Nullable agar baris lama valid tanpa backfill:
  // status null dibaca sebagai BARU lewat `resolvePengaduanStatus` (src/lib/pengaduan-status.ts).
  status             String?
  // Tanggapan admin, teks polos; tampil publik di rekap tindak lanjut — jangan memuat data pelapor.
  tanggapan          String?        @db.Text
  tanggapanAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime       @default(now())
  isActive           Boolean        @default(true)
}

