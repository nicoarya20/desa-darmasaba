// ========================================= USER ========================================= //

model User {
  id                    String           @id @default(cuid())
  username              String
  nomor                 String?          @unique // nullable: user login Google tidak punya nomor HP
  email                 String?          @unique // identitas dari Google OAuth
  googleId              String?          @unique // Google account ID, di-link saat login Google pertama
  avatarUrl             String? // foto profil dari Google — dipetakan ke Better Auth `image`
  emailVerified         Boolean          @default(false) // Better Auth core field
  roleId                String           @default("2")
  isActive              Boolean          @default(false)
  sessionInvalid        Boolean          @default(false)
  lastLogin             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now()) @updatedAt
  permissions           Json?
  sessions              UserSession[] // ⚠️ legacy JWT session — di-drop setelah cutover Better Auth
  authSessions          Session[] // Better Auth session
  accounts              Account[] // Better Auth account (provider google)
  role                  Role             @relation(fields: [roleId], references: [id])
  menuAccesses          UserMenuAccess[]
  menuVisibilityUpdates MenuVisibility[]
  jennaSettingsUpdates  JennaSettings[]  @relation("JennaSettingsUpdatedBy")
  jennaProviderUpdates  JennaProvider[]  @relation("JennaProviderUpdatedBy")
  auditLogs             AuditLog[]
  loginLogs             LoginLog[]

  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique // ADMIN_DESA, ADMIN_KESEHATAN, ADMIN_SEKOLAH
  description String?
  permissions Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]

  @@map("roles")
}

model KodeOtp {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  nomor     String
  otp       Int
  expiresAt DateTime?
}

model UserSession {
  id        String   @id @default(cuid())
  token     String   @db.Text // ✅ JWT bisa panjang
  expiresAt DateTime // ✅ Ubah jadi expiresAt (konsisten)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String // ✅ HAPUS @unique - user bisa punya multiple sessions

  @@index([userId]) // ✅ Index untuk query cepat
  @@index([token]) // ✅ Index untuk verify cepat
  @@map("user_sessions")
}

model UserMenuAccess {
  id        String   @id @default(cuid())
  userId    String
  menuId    String // ID menu (misal: "Landing Page", "Kesehatan")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, menuId]) // Satu user tidak bisa punya akses menu yang sama dua kali
}

// Override visibilitas submenu website publik (navbar/pencarian/Peta Informasi).
// Tanpa row = pakai default `hidden` di src/con/navbar-list-menu.ts. menuKey = href
// submenu (lebih stabil dari id urut "3.2"); divalidasi aplikasi terhadap config.
model MenuVisibility {
  id          String   @id @default(cuid())
  menuKey     String   @unique
  isVisible   Boolean
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================================== JENNA (asisten AI) ===================================== //
// Diatur di /dev/jenna (khusus role "0"). Singleton: id selalu "global".
// Batas nilai divalidasi aplikasi (src/lib/jenna/types.ts JENNA_SETTINGS_LIMITS).
model JennaSettings {
  id                      String   @id @default("global")
  enabled                 Boolean  @default(false)
  assistantName           String   @default("Jenna")
  personaNote             String   @default("") @db.VarChar(1500)
  maxInputChars           Int      @default(2000)
  historyWindow           Int      @default(6)
  rateLimitPerMinute      Int      @default(10)
  dailyMessagesUser       Int      @default(100)
  dailyTokensGlobal       Int      @default(0) // 0 = chat tidak aktif
  retentionDays           Int      @default(90)
  chatProtocol            String   @default("openai") // "openai" | "anthropic"
  voiceEnabled            Boolean  @default(false)
  voiceDailyMinutesUser   Int      @default(5)
  voiceDailyMinutesGlobal Int      @default(0) // 0 = suara tidak aktif (bukan tanpa batas)
  voiceSessionMaxMinutes  Int      @default(5)
  voiceIdleOffSeconds     Int      @default(60)
  voiceName               String   @default("") @db.VarChar(60)
  updatedAt               DateTime @updatedAt
  updatedById             String?
  updatedBy               User?    @relation("JennaSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// Satu row per slot provider ("chat_openai" | "chat_anthropic" | "voice"). apiKeyEnc = AES-256-GCM
// (src/lib/jenna/crypto.ts, format "v1:..."), tidak pernah dikirim ke klien.
model JennaProvider {
  slot            String    @id
  baseUrl         String    @default("")
  apiKeyEnc       String?
  apiKeyHint      String?   @db.VarChar(4)
  model           String    @default("")
  temperature     Float?
  maxTokens       Int?
  reasoningEffort String?
  timeoutMs       Int       @default(30000)
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?
  updatedAt       DateTime  @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("JennaProviderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// Percakapan pengunjung anonim (tanpa relasi User). sessionHash/ipHash = hash, bukan nilai mentah.
// Dihapus otomatis setelah JennaSettings.retentionDays.
model JennaConversation {
  id            String         @id @default(cuid())
  sessionHash   String
  ipHash        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastMessageAt DateTime       @default(now())
  messages      JennaMessage[]

  @@index([sessionHash])
}

// content sudah dimask (NIK/HP/email) oleh pemanggil sebelum disimpan.
// sessionHash/ipHash didenormalisasi untuk hitung kuota harian tanpa join.
model JennaMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   JennaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String            @db.Text
  status         String            @default("ok") // "ok" | "error"
  errorCode      String?
  inputTokens    Int               @default(0)
  outputTokens   Int               @default(0)
  toolsUsed      String[]
  // Telemetri giliran (developer console): di baris asisten bila sukses, di baris user ber-status error bila gagal.
  latencyMs      Int?
  providerSlot   String?
  model          String?
  errorDetail    String?           @db.Text // penyebab asli giliran gagal, sudah disanitasi; tidak pernah ke pengunjung
  modality       String            @default("text") // "text" | "voice"
  sessionHash    String
  ipHash         String
  createdAt      DateTime          @default(now())

  @@index([sessionHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@index([conversationId, createdAt])
}

// Sesi suara pengunjung anonim (relay WebRTC ke gateway). Menit dihitung dari jam server, bukan laporan klien.
// gatewaySessionId hanya untuk hangup server, tidak pernah dikirim ke klien. Dihapus bersama retensi percakapan.
model JennaVoiceSession {
  id               String    @id @default(cuid())
  sessionHash      String
  ipHash           String
  status           String    @default("starting") // "starting" | "active" | "ended"
  gatewaySessionId String?
  startedAt        DateTime  @default(now())
  lastHeartbeatAt  DateTime  @default(now())
  maxSeconds       Int // snapshot voiceSessionMaxMinutes * 60 saat mulai
  endedAt          DateTime?
  endReason        String?
  billedSeconds    Int       @default(0)
  hangupStatus     Int? // status HTTP hangup gateway; -1 = jaringan/timeout gagal; null = belum/tidak dipanggil

  @@index([sessionHash, startedAt])
  @@index([ipHash, startedAt])
  @@index([startedAt])
  @@index([status])
}

// ===================================== BETTER AUTH ===================================== //
// Model wajib Better Auth (pola base-template2). Session store di Postgres (tanpa Redis).

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String // ID akun di provider (mis. Google sub)
  providerId            String // "google"
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // tak dipakai (Google-only), disimpan untuk kompat Better Auth
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ========================================= KEPENDUDUKAN ========================================= //
// ========================================= DATA BANJAR ========================================= //
model DataBanjar {
  id        String    @id @default(cuid())
  nama      String // Nama banjar
  penduduk  Int // Jumlah penduduk
  kk        Int // Jumlah kepala keluarga
  miskin    Int // Jumlah penduduk miskin
  tahun     Int // Tahun data
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)

  @@index([tahun])
  @@index([isActive])
}

// ========================================= LAPORAN PENDUDUK BULANAN ========================================= //
// Laporan SID per banjar per bulan (juknis lomba 1.3). Tabel BARU & terpisah: DataBanjar (snapshot tahunan)
// tidak diubah supaya halaman publik Kependudukan dan summary dashboard tetap utuh.
// `banjar` = teks nama banjar (sama seperti DataBanjar.nama), bukan FK, jadi laporan lama tetap utuh bila banjar diubah.
// Tanpa unique (banjar, tahun, bulan): soft delete (deletedAt/isActive) membuat unique index memblokir input ulang,
// jadi duplikat aktif dicegah di API.
model LaporanPendudukBulanan {
  id        String    @id @default(cuid())
  banjar    String // Nama banjar
  tahun     Int // Tahun laporan
  bulan     Int // 1-12 (divalidasi di API)
  lakiLaki  Int // Jumlah penduduk laki-laki
  perempuan Int // Jumlah penduduk perempuan
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)

  @@index([tahun, bulan])
  @@index([banjar])
}

// ========================================= DISTRIBUSI AGAMA ========================================= //
model DistribusiAgama {
  id        String    @id @default(cuid())
  agama     String // Nama agama
  jumlah    Int // Jumlah penganut
  tahun     Int // Tahun data
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)

  @@index([tahun])
  @@index([isActive])
}

// ========================================= DISTRIBUSI UMUR ========================================= //
model DistribusiUmur {
  id          String    @id @default(cuid())
  rentangUmur String // Rentang umur (e.g., "0-14", "15-24", "25-54", "55-64", "65+")
  jumlah      Int // Jumlah penduduk
  tahun       Int // Tahun data
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)

  @@index([tahun])
  @@index([isActive])
}

// ========================================= MIGRASI PENDUDUK ========================================= //
model MigrasiPenduduk {
  id        String       @id @default(cuid())
  nama      String // Nama penduduk
  jenis     JenisMigrasi // MASUK atau KELUAR
  tanggal   DateTime // Tanggal migrasi
  asal      String? // Asal (untuk masuk)
  tujuan    String? // Tujuan (untuk keluar)
  alasan    String? // Alasan migrasi
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  isActive  Boolean      @default(true)

  @@index([tanggal])
  @@index([isActive])
}

enum JenisMigrasi {
  MASUK
  KELUAR
}

// ========================================= DINAMIKA PENDUDUK ========================================= //
model DinamikaPenduduk {
  id        String    @id @default(cuid())
  tahun     Int // Tahun data
  kelahiran Int // Jumlah kelahiran
  kematian  Int // Jumlah kematian
  masuk     Int // Jumlah penduduk masuk
  keluar    Int // Jumlah penduduk keluar
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)

  @@unique([tahun])
  @@index([tahun])
  @@index([isActive])
}

// ========================================= MUSIK DESA ========================================= //
model MusikDesa {
  id           String       @id @default(cuid())
  judul        String       @db.VarChar(255)
  artis        String       @db.VarChar(255)
  deskripsi    String?      @db.Text
  durasi       String       @db.VarChar(20) // format: "MM:SS"
  audioFile    FileStorage? @relation("MusikAudioFile", fields: [audioFileId], references: [id])
  audioFileId  String?
  coverImage   FileStorage? @relation("MusikCoverImage", fields: [coverImageId], references: [id])
  coverImageId String?
  genre        String?      @db.VarChar(100)
  tahunRilis   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  isActive     Boolean      @default(true)

  @@index([judul])
  @@index([artis])
}

model Umkm {
  id         String             @id @default(cuid())
  nama       String
  pemilik    String
  deskripsi  String?
  alamat     String?
  kontak     String?
  image      FileStorage?       @relation("UmkmImage", fields: [imageId], references: [id])
  imageId    String?
  kategori   KategoriProdukUmkm @relation(fields: [kategoriId], references: [id])
  kategoriId String
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  produk     PasarDesa[]
}

// Pengaturan tampilan katalog UMKM publik. Satu baris aktif (pola PerpustakaanConfig). Kenapa: desa sementara
// tidak mau menampilkan harga produk, dan admin tidak perlu menghapus harga satu per satu. Tanpa baris = harga tampil.
model UmkmConfig {
  id               String   @id @default(cuid())
  sembunyikanHarga Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
}

model KategoriProdukUmkm {
  id        String      @id @default(cuid())
  nama      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  isActive  Boolean     @default(true)
  Umkm      Umkm[]
  PasarDesa PasarDesa[]
}

model PenjualanProduk {
  id          String    @id @default(cuid())
  produk      PasarDesa @relation(fields: [produkId], references: [id])
  produkId    String
  jumlah      Int
  hargaSatuan Int // snapshot harga saat transaksi, agar histori tetap akurat
  totalNilai  Int // hargaSatuan * jumlah
  tanggal     DateTime  @default(now())
  periode     String // format "YYYY-MM" untuk grouping bulanan
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)

  @@index([periode])
  @@index([produkId])
  @@index([tanggal])
}

// ========================================= BEASISWA CONFIG ========================================= //
model BeasiswaConfig {
  id              String   @id @default(cuid())
  tahunAjaran     String
  danaTersalurkan BigInt   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)
}

// ========================================= IBU HAMIL ========================================= //
enum IbuHamilStatus {
  AKTIF
  MELAHIRKAN
  KEGUGURAN
  NONAKTIF
}

model IbuHamil {
  id            String         @id @default(cuid())
  nama          String
  nik           String?
  usiaKehamilan Int            @default(0)
  hpht          DateTime?
  taksiranLahir DateTime?
  alamat        String?
  noHp          String?
  catatan       String?
  posyanduId    String?
  posyandu      Posyandu?      @relation(fields: [posyanduId], references: [id], onDelete: SetNull)
  status        IbuHamilStatus @default(AKTIF)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isActive      Boolean        @default(true)
}

// ========================================= BALITA ========================================= //
enum JenisKelaminBalita {
  L
  P
}

enum StatusStunting {
  NORMAL
  ALERT
  STUNTING
}

model Balita {
  id               String             @id @default(cuid())
  nama             String
  nik              String?
  tanggalLahir     DateTime
  jenisKelamin     JenisKelaminBalita
  beratBadanKg     Float?
  tinggiBadanCm    Float?
  namaOrtu         String?
  alamat           String?
  noHpOrtu         String?
  posyanduId       String?
  posyandu         Posyandu?          @relation(fields: [posyanduId], references: [id], onDelete: SetNull)
  imunisasiLengkap Boolean            @default(false)
  giziBaik         Boolean            @default(true)
  pemeriksaanRutin Boolean            @default(true)
  statusStunting   StatusStunting     @default(NORMAL)
  catatan          String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  isActive         Boolean            @default(true)
}

// ========================================= RINGKASAN KESEHATAN DESA ========================================= //
model RingkasanKesehatanDesa {
  id                String   @id @default(cuid())
  targetStuntingPct Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  isActive          Boolean  @default(true)
}

// ========================================= EVENT BUDAYA ========================================= //
model EventBudaya {
  id             String    @id @default(cuid())
  nama           String
  tanggal        DateTime
  tanggalSelesai DateTime?
  kategori       String    @default("BUDAYA")
  lokasi         String
  deskripsi      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isActive       Boolean   @default(true)

  @@index([tanggal])
}

// ========================================= STRUKTUR PERANGKAT DESA ========================================= //
// Tabel sendiri, terpisah dari PPID & BUMDes: mengubah perangkat desa tidak menyentuh struktur lain
// (sebelumnya halaman Struktur Perangkat Desa menumpang data Struktur PPID).
model PosisiPerangkatDesa {
  id        String                @id @default(cuid())
  nama      String                @db.VarChar(100)
  deskripsi String?               @db.Text
  // Level bagan (1 = puncak). Urutan antar-jabatan selevel diatur `urutan` (kecil dulu).
  hierarki  Int
  urutan    Int                   @default(0)
  // Atasan langsung; null = puncak bagan. Bisa diatur dari admin.
  parentId  String?
  parent    PosisiPerangkatDesa?  @relation("PosisiPerangkatDesaParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  PosisiPerangkatDesa[] @relation("PosisiPerangkatDesaParent")
  pegawai   PerangkatDesa[]
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([parentId])
}

// Hanya nama + jabatan yang wajib; data lain boleh kosong (null) dan dilengkapi belakangan.
model PerangkatDesa {
  id            String              @id @default(cuid())
  namaLengkap   String              @db.VarChar(255)
  gelarAkademik String?             @db.VarChar(100)
  image         FileStorage?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId       String?
  tanggalMasuk  DateTime?           @db.Date
  // Tidak unik: boleh kosong untuk banyak orang.
  email         String?             @db.VarChar(255)
  telepon       String?             @db.VarChar(20)
  alamat        String?             @db.Text
  posisiId      String
  posisi        PosisiPerangkatDesa @relation(fields: [posisiId], references: [id])
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([posisiId])
  @@index([imageId])
}

// Jejak aksi admin (append-only). `meta` hanya id + nilai lama/baru field non-PII.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRoleId String?
  action      String
  targetType  String
  targetId    String?
  summary     String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// Riwayat login staf; `result` divalidasi di kode (success | blocked_inactive).
model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  roleId    String?
  result    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Tim Pengelola Website Desa (juknis lomba 2027 butir 8.3): singleton (id tetap "tim-pengelola-website", upsert admin; tanpa
// baris awal). Publik hanya melihat nomor SK + tautan PDF; daftar anggota hanya lewat endpoint admin. SetNull: menghapus
// berkas SK lewat /api/fileStorage/delete tidak boleh gagal ataupun ikut menghapus data tim.
model TimPengelolaWebsite {
  id        String                @id
  nomorSk   String // mis. "181 Tahun 2026"
  tanggalSk DateTime?             @db.Date
  skFile    FileStorage?          @relation(fields: [skFileId], references: [id], onDelete: SetNull)
  skFileId  String?
  anggota   AnggotaTimPengelola[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([skFileId])
}

// Anggota tim pengelola: daftar diganti utuh (hapus semua + isi ulang dalam satu transaksi) sehingga `urutan` selalu rapat
// 0..n-1. Jabatan teks bebas karena SK memuat banyak peran. Ikut terhapus bila tim dihapus (Cascade).
model AnggotaTimPengelola {
  id        String              @id @default(cuid())
  timId     String
  tim       TimPengelolaWebsite @relation(fields: [timId], references: [id], onDelete: Cascade)
  nama      String
  jabatan   String
  urutan    Int
  createdAt DateTime            @default(now())

  @@index([timId, urutan])
}
