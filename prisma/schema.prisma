  bankSampahId String
  nama         String
  jabatan      String
  image        FileStorage?                 @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId      String?
  urutan       Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([bankSampahId, urutan])
}

// Galeri foto kegiatan bank sampah; hapus permanen (tanpa panel Sampah).
model FotoKegiatanBankSampah {
  id           String                       @id @default(cuid())
  bankSampah   KeteranganBankSampahTerdekat @relation(fields: [bankSampahId], references: [id], onDelete: Cascade)
  bankSampahId String
  image        FileStorage                  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId      String
  keterangan   String?
  urutan       Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([bankSampahId, urutan])
}

