model DataLingkunganDesa {
  id        String   @id @default(cuid())
  name      String
  jumlah    String
  deskripsi String   @db.Text //deskripsi panjang
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

// ========================================= GOTONG ROYONG ========================================= //
model KegiatanDesa {
  id                 String           @id @default(uuid())
  judul              String
  deskripsiSingkat   String
  deskripsiLengkap   String
  tanggal            DateTime
  lokasi             String
  partisipan         Int
  image              FileStorage?     @relation(fields: [imageId], references: [id])
  imageId            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime         @default(now())
  isActive           Boolean          @default(true)
  kategoriKegiatan   KategoriKegiatan @relation(fields: [kategoriKegiatanId], references: [id])
  kategoriKegiatanId String

  // Khusus kategori Pembangunan (KATEGORI_PEMBANGUNAN_ID) — nullable agar data lama aman
  anggaran          Float? // Rupiah, tipe sama dengan APBDesItem.anggaran
  progres           Int? // 0–100 (CHECK constraint di migrasi)
  statusPembangunan String? // "rencana" | "berjalan" | "selesai" — divalidasi di API
  sumberDana        String?

  // Dokumentasi Pembangunan (opsional): foto sebelum & sesudah (maks 5 per jenis). Hanya untuk kategori Pembangunan.
  // Satu relasi untuk kedua jenis: Prisma tidak bisa memfilter relasi bernama ganda pada FK yang sama, dan satu include
  // + urutan (jenis, urutan) cukup untuk memecahnya di lib.
  foto KegiatanDesaFoto[]

  @@index([kategoriKegiatanId])
}

// Foto dokumentasi Kegiatan Desa kategori Pembangunan. `jenis` = "sebelum" | "sesudah" (divalidasi di
// src/lib/kegiatan-pembangunan-foto.ts), `urutan` = urutan tampil per jenis; ikut terhapus bersama kegiatan/berkas.
model KegiatanDesaFoto {
  id             String       @id @default(cuid())
  kegiatanDesa   KegiatanDesa @relation(fields: [kegiatanDesaId], references: [id], onDelete: Cascade)
  kegiatanDesaId String
  file           FileStorage  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId         String
  jenis          String
  urutan         Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([kegiatanDesaId, jenis, urutan])
}

// Dokumen perencanaan desa: RPJM (periode 6/8 tahun), RKP (per tahun), dan berita acara musyawarah.
model DokumenPerencanaan {
  id              String       @id @default(cuid())
  jenis           String // "RPJM" | "RKP" | "BERITA_ACARA_MUSYAWARAH" — divalidasi di API (src/lib/dokumen-perencanaan.ts)
  judul           String
  tahun           Int? // RKP & berita acara
  tahunMulai      Int? // RPJM
  tahunSelesai    Int? // RPJM (>= tahunMulai, divalidasi di API)
  nomorPerdes     String?
  ringkasan       String?      @db.Text
  jenisMusyawarah String? // "MUSDES" | "MUSRENBANGDES" | "MMD" | "LAINNYA" — hanya berita acara
  file            FileStorage? @relation(fields: [fileId], references: [id])
  fileId          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  isActive        Boolean      @default(true)

  @@index([jenis, tahun])
}

// Produk hukum desa (Perdes, Peraturan Perbekel, SK Perbekel, dll) untuk menu publik Pemerintahan > Produk Hukum.
// Satu baris = satu produk hukum; PDF-nya opsional supaya entri bisa dicatat dulu sebelum berkasnya ada. Daftar FLAT
// tanpa folder; pengelompokan lewat `kategori` (teks, divalidasi di API/src/lib/produk-hukum.ts, bukan enum Prisma
// agar kategori baru tidak butuh migrasi). SetNull: /api/fileStorage/delete tidak boleh gagal atau menghapus entri.
model ProdukHukum {
  id        String       @id @default(cuid())
  judul     String
  nomor     String? // mis. "Nomor 9 Tahun 2021"
  tahun     Int?
  kategori  String // "PERDES" | "PERATURAN_PERBEKEL" | "SK_PERBEKEL" | "LAINNYA"
  urutan    Int          @default(0) // pemutus seri bila tahun sama
  file      FileStorage? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  fileId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  isActive  Boolean      @default(true)

  @@index([isActive, kategori, urutan])
  @@index([fileId])
}

// Indeks Desa Membangun (IDM, Kemendesa PDTT): satu baris per tahun, skor dan status diisi admin apa adanya dari dokumen
// Kemendesa (tidak dihitung di kode). Skor 0-1; `status` = salah satu dari 5 status resmi IDM (dijaga API, lihat src/lib/indeks-desa.ts).
model IndeksDesa {
  id        String    @id @default(cuid())
  tahun     Int       @unique
  skorIdm   Float
  skorIks   Float // Indeks Ketahanan Sosial
  skorIke   Float // Indeks Ketahanan Ekonomi
