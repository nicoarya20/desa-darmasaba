}

model CategoryPengumuman {
  id          String       @id @default(cuid())
  name        String       @unique
  pengumumans Pengumuman[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime     @default(now())
  isActive    Boolean      @default(true)
}

// ========================================= GALLERY ========================================= //
model GalleryFoto {
