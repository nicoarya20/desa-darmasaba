  deletedAt      DateTime @default(now())
}

// ========================================= STRUKTUR ORGANISASI ========================================= //

model PosisiOrganisasiBumDes {
  id        String                   @id @default(cuid())
  nama      String                   @db.VarChar(100)
  deskripsi String?                  @db.Text
  hierarki  Int
  // Urutan antar-jabatan selevel di bagan (kecil dulu); sama dengan Struktur Perangkat Desa.
  urutan    Int                      @default(0)
  pegawai   PegawaiBumDes[]
  parentId  String?
  isActive  Boolean                  @default(true)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  parent    PosisiOrganisasiBumDes?  @relation("Parent", fields: [parentId], references: [id])
  children  PosisiOrganisasiBumDes[] @relation("Parent")
}

model PegawaiBumDes {
  id            String                 @id @default(cuid())
  namaLengkap   String                 @db.VarChar(255)
  gelarAkademik String?                @db.VarChar(100)
  image         FileStorage?           @relation(fields: [imageId], references: [id])
  imageId       String?
  tanggalMasuk  DateTime?              @db.Date
  // Tidak unik: email opsional, boleh kosong (null) untuk banyak pegawai.
  email         String?                @db.VarChar(255)
  telepon       String?                @db.VarChar(20)
  alamat        String?                @db.Text
  posisiId      String                 @db.VarChar(50)
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  posisi        PosisiOrganisasiBumDes @relation(fields: [posisiId], references: [id])
}

// Profil BUMDes (singleton): satu baris dengan id tetap "profil-bumdes", ditulis lewat upsert.
model ProfilBumDes {
  id           String             @id @default("profil-bumdes")
  nama         String             @db.VarChar(255)
  deskripsi    String             @db.Text
  alamat       String?            @db.Text
  kontak       String?            @db.VarChar(255)
  tahunBerdiri Int?
  image        FileStorage?       @relation(fields: [imageId], references: [id])
  imageId      String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  galeri       FotoProfilBumDes[]
}

// Galeri foto Profil BUMDes. Desa mengirim banyak foto, sedangkan ProfilBumDes.image hanya satu
// (tetap dipakai sebagai logo/cover), jadi tiap foto galeri butuh baris sendiri dengan keterangan
// dan urutan tampil. Hapus dari admin = soft delete (FileStorage tidak disentuh). Cascade di kedua FK:
// foto tidak berarti tanpa profilnya, dan hapus berkas permanen lewat /fileStorage/delete tidak boleh
// gagal karena berkas masih direferensikan.
model FotoProfilBumDes {
  id         String       @id @default(cuid())
  profil     ProfilBumDes @relation(fields: [profilId], references: [id], onDelete: Cascade)
  profilId   String       @default("profil-bumdes")
  image      FileStorage  @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId    String
  keterangan String?
  urutan     Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  isActive   Boolean      @default(true)
  deletedAt  DateTime?

  @@index([profilId, urutan])
}

// Daftar unit usaha BUMDes; urutan menentukan posisi tampil di halaman publik.
model UnitUsahaBumDes {
  id        String       @id @default(cuid())
  nama      String       @db.VarChar(255)
  deskripsi String       @db.Text
  image     FileStorage? @relation(fields: [imageId], references: [id])
  imageId   String?
  urutan    Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@index([isActive, deletedAt, urutan])
}

// ========================================= PROGRAM KEMISKINAN ========================================= //
model ProgramKemiskinan {
  id          String                      @id @default(uuid())
  nama        String
  // Penanda URL publik (/ekonomi/program-kemiskinan/{slug}); null = halaman detail memakai id.
  slug        String?                     @unique
  deskripsi   String
  icon        String
  isActive    Boolean                     @default(true)
  statistikId String?                     @unique
  statistik   StatistikKemiskinan?        @relation(fields: [statistikId], references: [id])
  penerima    PenerimaProgramKemiskinan[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
}

// Penerima bantuan per program per tahun. Sengaja hanya nama + alamat (keputusan user 2026-11-16):
// NIK, tanggal lahir, nomor KK, dst. dari BNBA desa tidak disimpan.
model PenerimaProgramKemiskinan {
  id        String            @id @default(cuid())
  programId String
  program   ProgramKemiskinan @relation(fields: [programId], references: [id], onDelete: Cascade)
  tahun     Int
  nama      String
  alamat    String
  urutan    Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([programId, tahun])
}

model StatistikKemiskinan {
  id                String             @id @default(uuid())
  tahun             Int                @unique
  jumlah            Int
  programKemiskinan ProgramKemiskinan?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

