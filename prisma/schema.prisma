  judul     String   @db.Text //deskripsi singkat
  deskripsi String   @db.Text //deskripsi panjang
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

