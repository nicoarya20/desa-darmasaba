{
  "mcpServers": {
    "github": {
      "command": "sh",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) npx -y @modelcontextprotocol/server-github"
      ]
    },
    "github-actions": {
      "command": "node",
      "args": [".claude/mcp/github-actions.mjs"]
    }
  }
}
