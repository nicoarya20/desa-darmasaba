+// PATCH(desa-darmasaba): browser bisa melewati (skip) transisi dan menolak
+// promise `ready`-nya; spec CSS View Transitions 1 TIDAK menandai `ready`
+// marked-as-handled, dan library ini tak pernah menangani `ready`, jadi skip
+// berubah jadi unhandledrejection. Dua skip yang wajar (navigasi tetap selesai,
+// hanya animasinya hilang):
+// - AbortError "Transition was skipped": startViewTransition() baru membatalkan
+//   transisi aktif (klik/back cepat saat route masih dimuat).
+// - TimeoutError "timeout in DOM update": callback menunggu route baru commit,
+//   dan Chrome membatasi DOM update ~4 detik (kompilasi route pertama di dev,
+//   atau jaringan/server lambat di prod).
+// Error lain dilempar ulang agar tetap terlihat.
+// Hapus patch ini bila upstream menangani `ready` sendiri.
+const EXPECTED_SKIP_ERRORS = [
+    'AbortError',
+    'TimeoutError'
+];
+function handleSkippedTransition(transition) {
+    transition.ready.catch((error)=>{
+        if (error && EXPECTED_SKIP_ERRORS.includes(error.name)) {
+            return;
+        }
+        throw error;
+    });
+}
