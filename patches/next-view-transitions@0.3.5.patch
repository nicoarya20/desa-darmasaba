+// PATCH(desa-darmasaba): startViewTransition() saat masih ada transisi aktif
+// membatalkan transisi lama dan menolak promise `ready`-nya dengan AbortError
+// (spec CSS View Transitions 1, "skip the view transition"; `ready` TIDAK
+// otomatis marked-as-handled). Library ini tak pernah menangani `ready`, jadi
+// klik/back cepat saat route masih dimuat memicu unhandledrejection
+// "Transition was skipped". AbortError = wajar (navigasi digantikan navigasi
+// baru, callback lama tetap jalan); error lain dilempar ulang agar tetap terlihat.
+// Hapus patch ini bila upstream menangani `ready` sendiri.
+function handleSkippedTransition(transition) {
+    transition.ready.catch((error)=>{
+        if (error && error.name === 'AbortError') {
+            return;
+        }
+        throw error;
+    });
+}
